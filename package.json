{
  "name": "google-workspace-admin-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Google Workspace admin plane: Directory, Reports, Vault, Cloud Search, Data Transfer, Licensing. Admin OAuth only - no impersonation, no service accounts.",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "google-workspace-admin-mcp": "dist/main.js"
  },
  "files": [
    "dist/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "tsx src/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check . && markdownlint-cli2 \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\" \"#.smoke/**\"",
    "lint:fix": "biome check --write . && markdownlint-cli2 --fix \"**/*.md\" \"#node_modules/**\" \"#dist/**\" \"#.git/**\"",
    "check": "npm run typecheck && npm run lint && npm run docs:scopes:check && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:scopes": "tsx scripts/generate-scopes.ts",
    "docs:scopes:check": "tsx scripts/generate-scopes.ts --check",
    "docs:tools": "tsx scripts/generate-tools.ts",
    "api:scopes": "tsx scripts/api-verify.ts",
    "smoke:status": "tsx scripts/smoke.ts --status",
    "smoke:read": "tsx scripts/smoke.ts --auto",
    "smoke:auto": "tsx scripts/smoke.ts --auto",
    "smoke:record": "tsx scripts/smoke.ts --auto --record"
  },
  "keywords": [
    "mcp",
    "model context protocol",
    "google workspace",
    "workspace admin",
    "admin sdk",
    "directory api",
    "reports api",
    "vault",
    "ediscovery",
    "cloud search",
    "data transfer",
    "license manager",
    "oauth 2.0",
    "ai agent"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singlebarrellabs/google-workspace-admin-mcp.git"
  },
  "homepage": "https://github.com/singlebarrellabs/google-workspace-admin-mcp#readme",
  "bugs": {
    "url": "https://github.com/singlebarrellabs/google-workspace-admin-mcp/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "googleapis": "^190.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@types/node": "^24.19.2",
    "markdownlint-cli2": "^0.24.1",
    "nock": "^15.0.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "author": "Single Barrel Labs",
  "publishConfig": {
    "access": "public"
  }
}
